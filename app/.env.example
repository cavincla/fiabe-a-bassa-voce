# In sviluppo con ./run.sh, DATABASE_URL è già impostata da docker-compose.yml
# verso il Postgres locale del container "db" — non serve valorizzarla qui.
# Questo valore serve per puntare a Supabase (staging/produzione, o per
# eseguire l'app senza Docker): Progetto > Project Settings > Database.
# Nessun valore va tra virgolette: "docker run --env-file" non le rimuove.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Progetto Supabase > Project Settings > API. Senza questi due, il login
# admin resta disattivato e /admin è aperta senza restrizioni (nessun
# errore, solo un avviso in pagina) — vedi STATO-PROGETTO.md per i passi
# di creazione del progetto.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Da usare solo lato server per operazioni con privilegi elevati (es. un
# futuro upload su Storage bypassando le policy) — non è ancora usata da
# nessun codice in questo repo. Non esporla mai con il prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
