# In sviluppo con ./run.sh, DATABASE_URL è già impostata da docker-compose.yml
# verso il Postgres locale del container "db" — non serve valorizzarla qui.
# Questo valore serve per puntare a Supabase (staging/produzione, o per
# eseguire l'app senza Docker): Progetto > Project Settings > Database.
# Nessun valore va tra virgolette: "docker run --env-file" non le rimuove.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
