generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

model AgeRange {
  id      String  @id @default(cuid())
  label   String  @unique // es. "3-5 anni"
  minAge  Int
  maxAge  Int
  stories Story[] @relation("StoryAgeRange")
}

model MoralTopic {
  id      String  @id @default(cuid())
  slug    String  @unique // es. "coraggio", "condivisione"
  stories Story[] @relation("StoryMoralTopics")
}

model HealthTopic {
  id      String  @id @default(cuid())
  slug    String  @unique // es. "alimentazione", "sonno"
  stories Story[] @relation("StoryHealthTopics")
}

model Story {
  id            String      @id @default(cuid())
  slug          String      @unique
  status        StoryStatus @default(DRAFT)
  coverImageUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ageRanges    AgeRange[]    @relation("StoryAgeRange")
  moralTopics  MoralTopic[]  @relation("StoryMoralTopics")
  healthTopics HealthTopic[] @relation("StoryHealthTopics")

  translations StoryTranslation[]
  pages        Page[]
}

model StoryTranslation {
  id          String @id @default(cuid())
  storyId     String
  story       Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  locale      String // es. "it", "en", "es"
  title       String
  description String

  @@unique([storyId, locale])
}

model Page {
  id       String  @id @default(cuid())
  storyId  String
  story    Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order    Int
  imageUrl String
  audioUrl String? // valorizzato dalla Fase 2 (audiolibro)

  translations PageTranslation[]

  @@unique([storyId, order])
}

model PageTranslation {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale String
  text   String

  @@unique([pageId, locale])
}

// L'utente admin vive in Supabase Auth: qui teniamo solo il collegamento
// al suo id (uuid di Supabase) e il ruolo, non le credenziali.
model AdminUser {
  id        String   @id // uuid di Supabase Auth
  email     String   @unique
  createdAt DateTime @default(now())
}
