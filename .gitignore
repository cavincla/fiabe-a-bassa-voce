# dependencies
app/node_modules/

# next.js
app/.next/
app/out/

# production
app/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
app/.env*
!app/.env.example

# typescript
app/*.tsbuildinfo
app/next-env.d.ts

# serwist (generated service worker)
app/public/sw.js
app/public/sw.js.map
app/public/swe-worker-*.js
app/public/swe-worker-*.js.map

# docker dev home (ignore everything except tracked dotfiles)
.data/*
!.data/bob-s-home
.data/bob-s-home/*
!.data/bob-s-home/.bashrc
